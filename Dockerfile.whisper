# Dockerfile.whisper
# Minimal REST wrapper around OpenAI Whisper.
# Build: docker build -f Dockerfile.whisper -t whisper-server .
# Expects: pip install openai-whisper flask gunicorn

FROM python:3.11-slim

RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir openai-whisper flask gunicorn

COPY scripts/whisper_server.py /app/whisper_server.py

EXPOSE 9001

CMD ["gunicorn", "--bind", "0.0.0.0:9001", "--timeout", "300", "whisper_server:app"]
