# Example environment variables — copy to .env and fill values
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BASE_URL=http://localhost:3000
COQUI_TTS_URL=http://localhost:5002
WHISPER_URL=http://localhost:9001
TOKENS_DB_PATH=./data/tokens.db
PORT=3000

# Optional: OpenAI fallback for AI adapter (used when Copilot CLI is unavailable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Copilot CLI timeout in milliseconds (default 30000)
COPILOT_TIMEOUT_MS=30000

# Optional: restrict CORS to your frontend origin in production
CORS_ORIGIN=*

# Optional: Sentry DSN for error tracking
SENTRY_DSN=

# Optional: log level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info

