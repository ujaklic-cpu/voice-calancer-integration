<?xml version="1.0" encoding="utf-8"?>
<!-- Allows cleartext HTTP for local/LAN server connections during development.
     For production, use HTTPS and remove the cleartextTrafficPermitted attribute. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
